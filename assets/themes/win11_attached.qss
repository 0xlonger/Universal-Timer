/*
 * 万能倒计时主题文件：Win11（吸附）
 *
 * 和 Win11 主题一样（半透明底、1px 描边、阴影，跟随系统深浅色），但悬浮条吸附在屏幕边上：
 * 贴着屏幕边的角是直角，贴边的一侧不画描边，其余的角保留圆角。
 * 悬浮条居中时贴着顶边；放在左上 / 右上时同时贴着顶边和左边 / 右边。设置里“悬浮条距顶边距离”不是 0 时就不贴顶边，上面的角变回圆角。
 * 其他部分没有写，使用默认主题。写法见 default.qss 开头的说明。
 */

@name Win11（吸附）;

/* 底色：WinUI 的 SolidBackgroundFillColorSecondary，不透明度 75%（和默认主题的白底一样） */
@var bar_background = rgba(238, 238, 238, 0.75);
@var-dark bar_background = rgba(28, 28, 28, 0.75);

/* 描边：WinUI 的 ControlElevationBorderBrush，底边稍深 */
@var bar_border = rgba(0, 0, 0, 0.06);
@var-dark bar_border = rgba(255, 255, 255, 0.07);
@var bar_border_bottom = rgba(0, 0, 0, 0.16);
@var-dark bar_border_bottom = rgba(255, 255, 255, 0.09);

/* 阴影：ClassIsland Fluent 主题的 BoxShadow="0 4 8 2 #48000000"（贴着屏幕边的一侧不留阴影） */
@var floating_bar_shadow_color = rgba(0, 0, 0, 0.28);
@var floating_bar_shadow_blur = 16;
@var floating_bar_shadow_offset_x = 0;
@var floating_bar_shadow_offset_y = 4;

/* 圆角和贴边一侧的描边用程序按位置算好的变量 */
@section FloatingBar
background: @bar_background; border: 1px solid @bar_border; border-bottom-color: @bar_border_bottom; border-top-style: @floating_bar_border_style_top; border-left-style: @floating_bar_border_style_left; border-right-style: @floating_bar_border_style_right; border-top-left-radius: @floating_bar_radius_top_left; border-top-right-radius: @floating_bar_radius_top_right; border-bottom-left-radius: @floating_bar_radius_bottom_left; border-bottom-right-radius: @floating_bar_radius_bottom_right; color: red;
